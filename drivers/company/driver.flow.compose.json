{
  "triggers": [
    {
      "id": "event_received",
      "title": {
        "en": "An event arrived from UteamUP",
        "is": "Atburður barst frá UteamUP"
      },
      "titleFormatted": {
        "en": "Event [[event]] arrived from UteamUP",
        "is": "Atburðurinn [[event]] barst frá UteamUP"
      },
      "hint": {
        "en": "Needs live events. Leave the event empty to react to every event, or enter one such as workorder.created or iot.alert.created.",
        "is": "Krefst atburða í rauntíma. Hafðu atburðinn tóman til að bregðast við öllum, eða skrifaðu t.d. workorder.created eða iot.alert.created."
      },
      "args": [
        {
          "type": "text",
          "name": "event",
          "required": false,
          "title": {
            "en": "Event",
            "is": "Atburður"
          },
          "placeholder": {
            "en": "workorder.created",
            "is": "workorder.created"
          }
        }
      ],
      "tokens": [
        {
          "name": "event",
          "type": "string",
          "title": {
            "en": "Event",
            "is": "Atburður"
          },
          "example": "iot.alert.created"
        },
        {
          "name": "title",
          "type": "string",
          "title": {
            "en": "Title",
            "is": "Titill"
          },
          "example": "Boiler pressure high"
        },
        {
          "name": "delivery_id",
          "type": "string",
          "title": {
            "en": "Delivery",
            "is": "Sending"
          },
          "example": "d6c1…"
        }
      ],
      "platforms": [
        "local"
      ]
    },
    {
      "id": "overdue_changed",
      "title": {
        "en": "The number of overdue work orders changed",
        "is": "Fjöldi verkbeiðna fram yfir tíma breyttist"
      },
      "tokens": [
        {
          "name": "overdue",
          "type": "number",
          "title": {
            "en": "Overdue",
            "is": "Fram yfir tíma"
          },
          "example": 2
        }
      ],
      "platforms": [
        "local"
      ]
    },
    {
      "id": "iot_alert_started",
      "title": {
        "en": "An IoT alert became active",
        "is": "IoT-viðvörun varð virk"
      },
      "tokens": [
        {
          "name": "count",
          "type": "number",
          "title": {
            "en": "Alerts",
            "is": "Viðvaranir"
          },
          "example": 1
        }
      ],
      "platforms": [
        "local"
      ]
    },
    {
      "id": "critical_stock_started",
      "title": {
        "en": "Stock became critical",
        "is": "Birgðir urðu á þrotum"
      },
      "platforms": [
        "local"
      ]
    }
  ],
  "conditions": [
    {
      "id": "overdue_above",
      "title": {
        "en": "Overdue work orders !{{are|are not}} above a number",
        "is": "Verkbeiðnir fram yfir tíma !{{eru|eru ekki}} fleiri en"
      },
      "titleFormatted": {
        "en": "Overdue work orders !{{are|are not}} above [[count]]",
        "is": "Verkbeiðnir fram yfir tíma !{{eru|eru ekki}} fleiri en [[count]]"
