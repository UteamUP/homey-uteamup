  "actions": [
    {
      "id": "create_work_order",
      "title": {
        "en": "Create a work order",
        "is": "Stofna verkbeiðni"
      },
      "titleFormatted": {
        "en": "Create work order [[name]] with priority [[priority]], due in [[due_in_days]] days, description [[description]], asset [[asset_guid]], assignee [[assignee_guid]]",
        "is": "Stofna verkbeiðnina [[name]] með forgang [[priority]], skil eftir [[due_in_days]] daga, lýsing [[description]], eign [[asset_guid]], ábyrgðaraðili [[assignee_guid]]"
      },
      "hint": {
        "en": "Asset and assignee are optional UteamUP GUIDs.",
        "is": "Eign og ábyrgðaraðili eru valfrjáls GUID úr UteamUP."
      },
      "args": [
        {
          "type": "text",
          "name": "name",
          "title": {
            "en": "Name",
            "is": "Heiti"
          },
          "placeholder": {
            "en": "Check the boiler",
            "is": "Athuga ketilinn"
          }
        },
        {
          "type": "number",
          "name": "priority",
          "min": 1,
          "max": 5,
          "step": 1,
          "title": {
            "en": "Priority (1–5)",
            "is": "Forgangur (1–5)"
          },
          "placeholder": {
            "en": "2",
            "is": "2"
          }
        },
        {
          "type": "number",
          "name": "due_in_days",
          "min": 0,
          "max": 3650,
          "step": 1,
          "title": {
            "en": "Due in days",
            "is": "Skiladagur eftir (dagar)"
          },
          "placeholder": {
            "en": "1",
            "is": "1"
          }
        },
        {
          "type": "text",
          "name": "description",
          "required": false,
          "title": {
            "en": "Description",
            "is": "Lýsing"
          }
        },
        {
          "type": "text",
          "name": "asset_guid",
          "required": false,
          "title": {
            "en": "Asset GUID",
            "is": "GUID eignar"
          },
          "placeholder": {
            "en": "00000000-0000-0000-0000-000000000000",
            "is": "00000000-0000-0000-0000-000000000000"
          }
        },
        {
          "type": "text",
          "name": "assignee_guid",
          "required": false,
          "title": {
            "en": "Assignee GUID",
            "is": "GUID ábyrgðaraðila"
          },
          "placeholder": {
            "en": "00000000-0000-0000-0000-000000000000",
            "is": "00000000-0000-0000-0000-000000000000"
          }
        }
      ],
      "tokens": [
        {
          "name": "work_order_guid",
          "type": "string",
          "title": {
            "en": "Work order GUID",
            "is": "GUID verkbeiðnar"
          },
          "example": "11111111-1111-4111-8111-111111111111"
        },
        {
          "name": "ticket_id",
          "type": "string",
          "title": {
            "en": "Ticket",
            "is": "Númer"
          },
          "example": "WO-42"
        }
      ],
      "platforms": [
        "local"
      ]
    },
    {
      "id": "create_quick_report",
      "title": {
        "en": "Report a problem",
        "is": "Tilkynna vandamál"
      },
      "titleFormatted": {
        "en": "Report [[description]] with severity [[severity]] on asset [[asset_guid]], tags [[tags]]",
        "is": "Tilkynna [[description]] með alvarleika [[severity]] á eign [[asset_guid]], merki [[tags]]"
      },
      "hint": {
        "en": "Creates a quick report in UteamUP, for example when a leak sensor goes off. Tags are comma separated.",
        "is": "Stofnar flýtitilkynningu í UteamUP, t.d. þegar lekaskynjari fer í gang. Merki eru aðskilin með kommu."
      },
      "args": [
        {
          "type": "text",
          "name": "description",
          "title": {
            "en": "Description",
            "is": "Lýsing"
          },
          "placeholder": {
            "en": "Water detected in the boiler room",
            "is": "Vatn í ketilherbergi"
          }
        },
        {
          "type": "dropdown",
          "name": "severity",
          "title": {
            "en": "Severity",
            "is": "Alvarleiki"
          },
          "values": [
            {
              "id": "low",
              "title": {
                "en": "Low",
                "is": "Lág"
              }
            },
            {
              "id": "medium",
              "title": {
                "en": "Medium",
                "is": "Miðlungs"
              }
            },
            {
              "id": "high",
              "title": {
                "en": "High",
                "is": "Há"
              }
            },
            {
              "id": "critical",
              "title": {
                "en": "Critical",
                "is": "Alvarleg"
              }
            }
          ]
        },
        {
          "type": "text",
          "name": "asset_guid",
          "required": false,
          "title": {
            "en": "Asset GUID",
            "is": "GUID eignar"
          },
          "placeholder": {
            "en": "00000000-0000-0000-0000-000000000000",
            "is": "00000000-0000-0000-0000-000000000000"
          }
        },
        {
          "type": "text",
          "name": "tags",
          "required": false,
          "title": {
            "en": "Tags",
            "is": "Merki"
          },
          "placeholder": {
            "en": "leak, homey",
            "is": "leki, homey"
          }
        }
      ],
      "tokens": [
        {
          "name": "work_order_guid",
          "type": "string",
          "title": {
            "en": "Work order GUID",
            "is": "GUID verkbeiðnar"
          },
          "example": "11111111-1111-4111-8111-111111111111"
        },
        {
          "name": "ticket_id",
          "type": "string",
          "title": {
            "en": "Ticket",
            "is": "Númer"
          },
          "example": "WO-42"
