          },
          {
            "type": "dropdown",
            "name": "severity",
            "title": {
              "en": "Severity"
            },
            "values": [
              {
                "id": "low",
                "title": {
                  "en": "Low"
                }
              },
              {
                "id": "medium",
                "title": {
                  "en": "Medium"
                }
              },
              {
                "id": "high",
                "title": {
                  "en": "High"
                }
              },
              {
                "id": "critical",
                "title": {
                  "en": "Critical"
                }
              }
            ]
