        "tokens": [
          {
            "name": "work_order_guid",
            "type": "string",
            "title": {
              "en": "Work order GUID"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          },
          {
            "name": "ticket_id",
            "type": "string",
            "title": {
              "en": "Ticket"
            },
            "example": "WO-42"
          }
        ],
        "platforms": [
          "local"
        ]
      },
