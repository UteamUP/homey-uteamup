          {
            "type": "text",
            "name": "asset_guid",
            "required": false,
            "title": {
              "en": "Asset GUID"
            },
            "placeholder": {
              "en": "00000000-0000-0000-0000-000000000000"
            }
          },
          {
            "type": "text",
            "name": "tags",
            "required": false,
            "title": {
              "en": "Tags"
            },
            "placeholder": {
              "en": "leak, homey"
