  "flow": {
    "triggers": [
      {
        "id": "event_received",
        "title": {
          "en": "An event arrived from UteamUP"
        },
        "titleFormatted": {
          "en": "Event [[event]] arrived from UteamUP"
        },
        "hint": {
          "en": "Needs live events. Leave the event empty to react to every event, or enter one such as workorder.created or iot.alert.created."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=company"
          },
          {
            "type": "text",
            "name": "event",
            "required": false,
            "title": {
              "en": "Event"
            },
            "placeholder": {
              "en": "workorder.created"
            }
          }
        ],
        "tokens": [
          {
            "name": "event",
            "type": "string",
            "title": {
              "en": "Event"
            },
            "example": "iot.alert.created"
          },
          {
            "name": "title",
            "type": "string",
            "title": {
              "en": "Title"
            },
            "example": "Boiler pressure high"
          },
          {
            "name": "delivery_id",
            "type": "string",
            "title": {
              "en": "Delivery"
            },
            "example": "d6c1…"
          }
        ],
        "platforms": [
          "local"
        ]
      },
      {
        "id": "overdue_changed",
        "title": {
          "en": "The number of overdue work orders changed"
        },
        "tokens": [
          {
            "name": "overdue",
            "type": "number",
            "title": {
              "en": "Overdue"
            },
            "example": 2
          }
        ],
        "platforms": [
          "local"
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=company"
          }
        ]
      },
      {
        "id": "iot_alert_started",
        "title": {
          "en": "An IoT alert became active"
        },
        "tokens": [
          {
            "name": "count",
            "type": "number",
            "title": {
              "en": "Alerts"
            },
            "example": 1
          }
        ],
        "platforms": [
          "local"
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=company"
          }
        ]
      },
      {
        "id": "critical_stock_started",
        "title": {
          "en": "Stock became critical"
        },
        "platforms": [
          "local"
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=company"
          }
        ]
      }
    ],
