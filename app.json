        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=company"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "create_work_order",
        "title": {
          "en": "Create a work order"
        },
        "titleFormatted": {
          "en": "Create work order [[name]] with priority [[priority]], due in [[due_in_days]] days, description [[description]], asset [[asset_guid]], assignee [[assignee_guid]]"
        },
        "hint": {
          "en": "Asset and assignee are optional UteamUP GUIDs."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=company"
          },
          {
            "type": "text",
            "name": "name",
            "title": {
              "en": "Name"
            },
            "placeholder": {
              "en": "Check the boiler"
            }
          },
          {
            "type": "number",
            "name": "priority",
            "min": 1,
            "max": 5,
            "step": 1,
            "title": {
              "en": "Priority (1–5)"
            },
            "placeholder": {
              "en": "2"
            }
          },
          {
            "type": "number",
            "name": "due_in_days",
            "min": 0,
            "max": 3650,
            "step": 1,
            "title": {
              "en": "Due in days"
            },
            "placeholder": {
              "en": "1"
            }
          },
          {
            "type": "text",
            "name": "description",
            "required": false,
            "title": {
              "en": "Description"
            }
          },
          {
            "type": "text",
            "name": "asset_guid",
            "required": false,
            "title": {
              "en": "Asset GUID"
            },
            "placeholder": {
              "en": "00000000-0000-0000-0000-000000000000"
            }
          },
          {
            "type": "text",
            "name": "assignee_guid",
            "required": false,
            "title": {
              "en": "Assignee GUID"
            },
            "placeholder": {
              "en": "00000000-0000-0000-0000-000000000000"
            }
          }
        ],
        "tokens": [
          {
            "name": "work_order_guid",
            "type": "string",
            "title": {
              "en": "Work order GUID"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          },
          {
            "name": "ticket_id",
            "type": "string",
            "title": {
              "en": "Ticket"
            },
            "example": "WO-42"
          }
        ],
        "platforms": [
          "local"
        ]
      },
      {
        "id": "create_quick_report",
        "title": {
          "en": "Report a problem"
        },
        "titleFormatted": {
          "en": "Report [[description]] with severity [[severity]] on asset [[asset_guid]], tags [[tags]]"
        },
        "hint": {
          "en": "Creates a quick report in UteamUP, for example when a leak sensor goes off. Tags are comma separated."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=company"
          },
          {
            "type": "text",
